<Window x:Class="VigilanteMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VigilanteMusic"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="btnNext" Content="Next" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="336,397,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="20"/>
        <Button x:Name="btnBack" Content="Back" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="283,397,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="20"/>
        <Button x:Name="btnRepeat" Content="Repeat" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="300,365,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="20"/>
        <Button x:Name="btnShuffle" Content="Shuffle" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="417,365,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="20"/>
        <Button x:Name="btnPause" Content="(Un)Pause" HorizontalAlignment="Left" Margin="400,397,0,0" VerticalAlignment="Top" Grid.Column="1" FontFamily="Arial" FontSize="20"/>
        <ListBox x:Name="TrackQueueList" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalAlignment="Left" FontFamily="Arial" FontSize="16"  Background="LightGray" MaxWidth="200"/>
        <Label x:Name="CurrentTrackLabel" Content="Ничего не играет" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" FontFamily="Arial" FontSize="18"/>
    </Grid>
</Window>
