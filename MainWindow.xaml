<Window x:Class="VigilanteMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigilante Music Player" Height="600" Width="1000"
        Background="#1E1E1E" Foreground="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>


        <Border Grid.Column="0" Grid.Row="0" BorderBrush="#333" BorderThickness="0,0,1,0" Background="#252526">
            <DockPanel>
                <TextBlock Text="Playlists" Margin="10" FontWeight="Bold" FontSize="14" DockPanel.Dock="Top"/>
                <ListBox x:Name="PlaylistBox" 
                         Background="Transparent" 
                         BorderThickness="0"
                         SelectionChanged="PlaylistBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="5" Foreground="#DDD"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>


        <Grid Grid.Column="1" Grid.Row="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
                
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top"
            Height="32" Margin="6,4" Panel.ZIndex="1">
                <Button x:Name="BtnAddFolder" Content="Add folder" Padding="8,2" Margin="0,0,4,0"
            Click="BtnAddFolder_Click"/>
                <Button x:Name="BtnNewPlaylist" Content="New playlist" Padding="8,2" Margin="0,0,4,0"
            Click="BtnNewPlaylist_Click"/>
                <Button x:Name="BtnDeletePlaylist" Content="Delete playlist" Padding="8,2" Margin="0,0,12,0"
            Click="BtnDeletePlaylist_Click"/>
                <ComboBox x:Name="TargetPlaylistBox" Width="130" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnAddToPlaylist" Content="Add to →" Padding="8,2" Margin="0,0,4,0"
            Click="BtnAddToPlaylist_Click"/>
                <Button x:Name="BtnRemoveTrack" Content="Remove" Padding="8,2"
            Click="BtnRemoveTrack_Click"/>
            </StackPanel>

            <ListBox x:Name="TrackQueueList" 
                     Grid.Row="0"
                     Margin="0,40,0,0"
                     SelectionMode="Extended"
                     Background="Transparent" 
                     BorderThickness="0"
                     SelectionChanged="TrackQueueList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Width="200"/>
                            <TextBlock Text="{Binding Artist}" Foreground="#AAA" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>


            <Border Grid.Row="1" Background="#2D2D30" Margin="10">
                <Image x:Name="CoverImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>


        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                Background="#333337" BorderBrush="#1E1E1E" BorderThickness="0,1,0,0">

            <DockPanel LastChildFill="True" Margin="10,0">


                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Width="300">
                    <TextBlock x:Name="LblTitle" Text="No Track Selected" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="LblArtist" Text="..." Foreground="#AAA" FontSize="12"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnShuffle"  Width="70" Margin="0,0,10,0" Click="BtnShuffle_Click">
                        <Image Source="/Source/Icon/Shuffle.png"></Image>
                    </Button>
                    <Button x:Name="BtnRepeat" Width="70" Click="BtnRepeat_Click">
                        <Image Source="/Source/Icon/Repeat.png"></Image>
                    </Button>
                </StackPanel>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnPrev"  Width="40" Margin="5" Click="BtnPrev_Click">
                        <Image Source="/Source/Icon/ArrowRight.png" Width="40" Height="40">
                            <Image.RenderTransform>
                                <RotateTransform CenterX="17" CenterY="20" Angle="180"/>
                            </Image.RenderTransform>
                        </Image>
                    </Button>
                    <Button x:Name="BtnPause"  Width="80" Margin="5" Click="BtnPause_Click">
                        <Image x:Name="PauseIcon" Source="/Source/Icon/UnPause.png"></Image>
                    </Button>
                    <Button x:Name="BtnNext" Width="40" Margin="5" Click="BtnNext_Click">
                        <Image Source="/Source/Icon/ArrowRight.png" Width="40" Height="40"></Image>
                    </Button>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1.0" Value="0.5" Width="150"  ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50,0,0,0" />
                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
</Window>